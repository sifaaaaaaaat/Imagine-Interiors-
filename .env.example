# Imagine Interiors — Admin CMS
# Copy this file to .env.local and fill in the values.

# Password that unlocks the /admin dashboard (required for local and production use)
ADMIN_PASSWORD=change-me

# OPTIONAL — enable "Save to GitHub" so content edits are committed and pushed
# to this repository from the admin dashboard. Requires a GitHub Personal Access
# Token (classic) with the "repo" scope.
GITHUB_TOKEN=
GITHUB_OWNER=sifaaaaaaaat
GITHUB_REPO=Imagine-Interiors-
GITHUB_BRANCH=main
